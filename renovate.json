{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track tool versions pinned in inventory host_vars/group_vars (kubectl, talosctl, flux, helm, helm-diff)",
      "managerFilePatterns": [
        "/^inventory/(host|group)_vars/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+?) depName=(?<depName>[^\\s]+?) packageName=(?<packageName>[^\\s]+?)(?: extractVersion=(?<extractVersion>[^\\s]+?))?\\s+\\w+_version:\\s*[\"']?(?<currentValue>[\\w.\\-]+)[\"']?"
      ]
    }
  ]
}
